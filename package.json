{
  "name": "dsh-liang-says",
  "version": "0.1.4",
  "description": "任意模式任务运行期间的梁选语录与视觉效果",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cct124/dsh-liang-says.git"
  },
  "homepage": "https://github.com/cct124/dsh-liang-says#readme",
  "bugs": {
    "url": "https://github.com/cct124/dsh-liang-says/issues"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.x"
  },
  "exports": {
    ".": "./dist/release/index.js",
    "./client": "./dist/release/client.js",
    "./locale/*.json": "./dist/release/locale/*.json",
    "./icon": "./dist/release/icon.svg"
  },
  "files": [
    "dist/release"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dist/release/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "prepare": "npm run build",
    "quotes": "node scripts/structure-quotes.mjs",
    "quotes:check": "node scripts/structure-quotes.mjs --check",
    "build:dev": "node scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev --watch",
    "dsh:install": "node scripts/dsh.mjs install",
    "dsh:start": "node scripts/dsh.mjs start",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "pack:dev": "npm run build:dev && npm pack ./dist/dev --pack-destination ./dist",
    "check": "npm run quotes:check && npm run typecheck && npm test",
    "check:git-install": "node scripts/check-git-install.mjs",
    "pack:release": "npm run build && node scripts/pack-release.mjs",
    "release:prepare": "npm run check && npm run pack:release",
    "release:metadata": "node scripts/release.mjs metadata",
    "release:npm": "node scripts/release.mjs npm",
    "release:github": "node scripts/release.mjs github"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "0.28.1",
    "pixi.js": "8.22.0",
    "typescript": "6.0.3"
  }
}
